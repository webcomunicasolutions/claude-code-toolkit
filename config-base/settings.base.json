{
  "model": "opus",
  "language": "Español",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "cleanupPeriodDays": 90,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo rm:*)",
      "Bash(shred:*)",
      "Bash(unlink:*)",
      "Bash(truncate:*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker-compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/aviso-contexto.sh", "timeout": 10 }
        ]
      }
    ]
  },
  "voice": { "enabled": true, "mode": "hold" },
  "voiceEnabled": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
